# ---- Supabase (same project as your existing apps: wcwjwchjxfcdupdqipks) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Analytics (optional until you're ready; app runs fine without them) ----
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Note: SMTP2GO (email OTP) and MSG91 (phone OTP via Send SMS Hook) are
# configured inside Supabase Auth, not here.

# ---- VSAT interviews: the admissions Google account (server-only) ----
# Makes the Calendar event + Meet link for each interview and reads Meet attendance.
# A separate Google account from PeerPath's. Setup: docs/vsat/interview-scheduling.md
# Without these, interviews still save and emails still go (with the dashboard link);
# the Meet column stays "Creating" until they are set.
ADMISSIONS_GOOGLE_CLIENT_ID=
ADMISSIONS_GOOGLE_CLIENT_SECRET=
ADMISSIONS_GOOGLE_REFRESH_TOKEN=
ADMISSIONS_ORGANIZER_EMAIL=
# "live" = invite anyone. Anything else (staging) = invite only the emails below.
ADMISSIONS_INVITE_MODE=
ADMISSIONS_TEST_EMAILS=
